#!/usr/bin/env python3
import os
import sys

import importlib
from pathlib import Path
script_dir = Path(__file__).resolve().parent
lib_dir = script_dir / '..' / 'lib'
sys.path.insert(0, str(lib_dir))
sys.path.insert(1, str(script_dir))


# 1. Add project root to sys.path to allow importing 'config'
# (Assumes bin/ is a subfolder of your main project root)
PROJECT_DIR = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..")
)
if PROJECT_DIR not in sys.path:
  sys.path.insert(0, PROJECT_DIR)

# 2. Define absolute path to actual system curl binary (prevents infinite recursion)
REAL_CURL = "/usr/bin/curl"

# 3. Import config and extract auth key
auth_key = None
from config import config

# Try reading key from GLOBAL section
if "GLOBAL" in config and "X-AUTHKEY" in config["GLOBAL"]:
  auth_key = config["GLOBAL"]["X-AUTHKEY"]

# 4. Construct argument list
# sys.argv[1:] contains all CLI parameters passed to this wrapper script
extra_args = []
if auth_key:
  extra_args = ["-H", f"X-AUTHKEY: {auth_key}"]

# Complete argument list for actual curl invocation
# First item in execv args list must be the executable path/name itself
final_args = [REAL_CURL] + extra_args + sys.argv[1:]

# 5. Replace current Python process image with the actual curl binary
try:
  os.execv(REAL_CURL, final_args)
except FileNotFoundError:
  sys.stderr.write(f"Error: System curl binary not found at {REAL_CURL}.\n")
  sys.exit(1)

